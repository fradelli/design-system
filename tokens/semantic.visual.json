{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "surface": {
    "glass": {
      "background": {
        "$type": "string",
        "$value": "color-mix(in srgb, {color.surface} 80%, transparent)"
      },
      "elevatedBackground": {
        "$type": "string",
        "$value": "color-mix(in srgb, {color.surfaceElevated} 94%, transparent)"
      },
      "border": {
        "$type": "string",
        "$value": "color-mix(in srgb, {color.mutedForeground} 24%, transparent)"
      },
      "blur": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "shadow": {
        "$type": "string",
        "$value": "0 8px 32px color-mix(in srgb, {color.background} 25%, transparent)"
      }
    },
    "hoverBorder": {
      "$type": "string",
      "$value": "color-mix(in srgb, {color.primary} 45%, {color.border})"
    }
  },
  "text": {
    "card": {
      "size": {
        "$type": "dimension",
        "$value": "{font.size.lg}"
      },
      "lineHeight": {
        "$type": "dimension",
        "$value": "{font.lineHeight.lg}"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.heading}"
      },
      "tracking": {
        "$type": "dimension",
        "$value": {
          "value": -0.015,
          "unit": "em"
        }
      }
    },
    "section": {
      "size": {
        "$type": "dimension",
        "$value": "{font.size.xl}"
      },
      "lineHeight": {
        "$type": "dimension",
        "$value": {
          "value": 32,
          "unit": "px"
        }
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.heading}"
      },
      "tracking": {
        "$type": "dimension",
        "$value": {
          "value": -0.025,
          "unit": "em"
        }
      }
    },
    "body": {
      "size": {
        "$type": "dimension",
        "$value": "{font.size.md}"
      },
      "lineHeight": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.body}"
      },
      "tracking": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "display": {
      "size": {
        "$type": "dimension",
        "$value": "{font.size.2xl}"
      },
      "lineHeight": {
        "$type": "dimension",
        "$value": {
          "value": 40,
          "unit": "px"
        }
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.heading}"
      },
      "tracking": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "interface": {
      "size": {
        "$type": "dimension",
        "$value": "{font.size.sm}"
      },
      "lineHeight": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.body}"
      },
      "tracking": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "label": {
      "size": {
        "$type": "dimension",
        "$value": "{font.size.sm}"
      },
      "lineHeight": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.label}"
      },
      "tracking": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "em"
        }
      }
    }
  },
  "card": {
    "padding": {
      "default": {
        "$type": "dimension",
        "$value": "{space.6}"
      },
      "compact": {
        "$type": "dimension",
        "$value": "{space.4}"
      }
    },
    "gap": {
      "default": {
        "$type": "dimension",
        "$value": "{space.4}"
      },
      "compact": {
        "$type": "dimension",
        "$value": "{space.3}"
      }
    }
  }
}
